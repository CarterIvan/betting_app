# Copy this file to .env (or .env.local) and fill in your own Supabase
# project's values — find them in the Supabase dashboard under
# Project Settings > API.
#
# VITE_SUPABASE_ANON_KEY is the public "anon" key. It is safe to ship in
# frontend code because every table it can touch is protected by Row Level
# Security (see supabase/migrations/0001_init.sql).
#
# NEVER put the service_role key in this file or anywhere in frontend code —
# it bypasses RLS entirely and must only ever be used server-side.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
